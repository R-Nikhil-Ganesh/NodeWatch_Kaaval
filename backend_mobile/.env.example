# Backend server host/port
HOST=0.0.0.0
PORT=3000

# Comma-separated origins allowed by CORS (set to your LAN IP once)
# Example: http://172.17.176.1:19006,http://172.17.176.1:3000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: Fabric/other envs
# FABRIC_HOST=localhost
# FABRIC_TLS_OVERRIDE=peer0.org1.example.com
# FABRIC_IDENTITY=appUser
