 // .env.example
// Copy this file to .env and update with your actual values

// Backend API Configuration (used by Expo via EXPO_PUBLIC_API_BASE_URL)
EXPO_PUBLIC_API_BASE_URL=http://172.17.176.1:3000

// Optional legacy vars
REACT_NATIVE_API_URL=http://localhost:3000
BACKEND_HOST=localhost
BACKEND_PORT=3000

// Hyperledger Fabric Configuration (for reference)
FABRIC_GATEWAY=mychannel
FABRIC_CHAINCODE=evidence
FABRIC_ORG=org1

// Debug Logging
DEBUG_API=true
