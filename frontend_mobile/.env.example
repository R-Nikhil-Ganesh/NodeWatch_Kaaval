 // .env.example
// Copy this file to .env and update with your actual values

// Backend API Configuration (used by Expo via EXPO_PUBLIC_API_BASE_URL)
// The unified backend listens on port 4000 (see backend/.env PORT=4000) — not 3000.
EXPO_PUBLIC_API_BASE_URL=http://172.17.176.1:4000

// Optional legacy vars (currently unread by any code in this app — kept for reference only)
REACT_NATIVE_API_URL=http://localhost:4000
BACKEND_HOST=localhost
BACKEND_PORT=4000

// Hyperledger Fabric Configuration (for reference)
FABRIC_GATEWAY=mychannel
FABRIC_CHAINCODE=evidence
FABRIC_ORG=org1

// Debug Logging
DEBUG_API=true
