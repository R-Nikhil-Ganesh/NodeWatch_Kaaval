# =================================================================
# Kaaval Environment Variables Template (.env.example)
# Copy this file to .env and configure your local/production secrets.
# DO NOT commit the .env file to version control.
# =================================================================

# --- PostgreSQL Database ---
DB_NAME=kaaval_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_PORT=5433

# --- MinIO S3 Object Storage ---
MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=evidence-vault
MINIO_ENDPOINT=http://127.0.0.1:9000

# --- Backend Application ---
PORT=4000
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# --- Hyperledger Fabric Network ---
FABRIC_DISABLED=false
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=evidence
FABRIC_DISCOVERY=true
FABRIC_AS_LOCALHOST=true
FABRIC_USER=appUser
